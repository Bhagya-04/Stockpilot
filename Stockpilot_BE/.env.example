# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development
# SQLAlchemy/psycopg URL. postgres:// and postgresql:// URLs from hosting providers are also accepted.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/stockpilot
# Used by the test-suite only; must point at a DIFFERENT, disposable database (its tables get wiped).
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/stockpilot_test
# At least 32 random characters. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated browser origins allowed to call the API (your deployed frontend URL).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
